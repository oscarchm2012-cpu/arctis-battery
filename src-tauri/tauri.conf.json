{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arctis 3 Battery Monitor",
  "version": "1.0.6",
  "identifier": "com.arctisbattery.monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arctis 3 Battery Monitor",
        "width": 400,
        "height": 660,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#0a0a0b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Arctis Battery Monitor",
    "shortDescription": "Battery monitor for SteelSeries Arctis 3 Bluetooth",
    "longDescription": "Shows the real battery level of SteelSeries Arctis 3 Bluetooth headphones in the Windows taskbar, read through Windows Bluetooth APIs.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
